{
  "name": "@open-generative/ag-ui",
  "version": "0.3.17",
  "description": "Explicit server and client AG-UI event adapters for Open Generative.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/index.d.mts", "import": "./dist/index.mjs" },
    "./server": { "types": "./dist/server.d.mts", "import": "./dist/server.mjs" },
    "./client": { "types": "./dist/client.d.mts", "import": "./dist/client.mjs" }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "tsc --noEmit",
    "test": "bun test src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "@open-generative/protocol": "workspace:*", "@open-generative/server": "workspace:*", "@open-generative/client": "workspace:*" },
  "devDependencies": { "@types/bun": "1.3.14", "tsdown": "0.22.14", "typescript": "7.0.2" }
}
