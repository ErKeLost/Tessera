{
  "name": "@data-elements/evals",
  "version": "0.1.0",
  "description": "Server-only versioned conformance and release gate evaluation for Artifact UI.",
  "type": "module",
  "sideEffects": ["./dist/browser.mjs"],
  "files": ["dist", "manifests"],
  "exports": { ".": { "types": "./dist/index.d.mts", "browser": "./dist/browser.mjs", "import": "./dist/index.mjs" } },
  "scripts": {
    "build": "tsdown",
    "lint": "tsc --noEmit",
    "test": "bun test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "@data-elements/runtime": "workspace:*", "zod": "4.4.3" },
  "devDependencies": { "@types/bun": "1.3.14", "tsdown": "0.22.14", "typescript": "7.0.2" }
}
