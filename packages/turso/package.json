    }
  },
  "browser": {
    "./dist/index.mjs": "./dist/browser.mjs"
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.3"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "tsc --noEmit",
    "test": "bun test src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@data-elements/sqlite": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2"
  }
}
