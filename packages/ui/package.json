{
  "name": "@open-generative/ui",
  "version": "0.3.5",
  "description": "Open Generative UI components and artifact renderers.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsdown && cp src/styles.css dist/styles.css",
    "lint": "tsc --noEmit",
    "test": "bun test src/*.test.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@open-tessera/core": "workspace:*",
    "@open-tessera/runtime": "workspace:*",
    "@open-tessera/schema": "workspace:*",
    "@radix-ui/react-tabs": "1.1.21",
    "lucide-react": "1.31.0",
    "recharts": "3.10.1"
  },
  "peerDependencies": {
    "react": ">=18.3.0",
    "react-dom": ">=18.3.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsdown": "0.22.14",
    "typescript": "7.0.2"
  }
}
