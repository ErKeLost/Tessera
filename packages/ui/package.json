{
  "name": "@open-generative/ui",
  "version": "0.3.11",
  "description": "Official React renderers for the Open Generative component catalog and ChartSpec.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./renderer-manifest.json": "./dist/renderer-manifest.json",
    "./renderer-release.json": "./dist/renderer-release.json",
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsdown && cp src/styles.css dist/styles.css && bun scripts/renderer-manifest.ts write-and-verify",
    "lint": "tsc --noEmit",
    "test": "bun test src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@open-generative/catalog": "workspace:*",
    "@open-generative/components": "workspace:*",
    "@open-generative/protocol": "workspace:*",
    "@open-generative/react": "workspace:*",
    "lucide-react": "1.31.0",
    "recharts": "3.10.1"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@open-generative/client": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsdown": "0.22.14",
    "typescript": "7.0.2"
  }
}
