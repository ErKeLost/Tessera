{
  "name": "@open-generative/react",
  "version": "0.3.8",
  "description": "Open Generative React Surface and renderer registry binding.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown --config ../../tsdown.package.config.ts",
    "lint": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@open-generative/protocol": "workspace:*",
    "@open-generative/catalog": "workspace:*",
    "@open-generative/client": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsdown": "0.22.14",
    "typescript": "7.0.2"
  }
}
