    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@open-tessera/capabilities": "workspace:*",
    "@open-tessera/core": "workspace:*",
    "@open-tessera/runtime": "workspace:*",
    "@open-tessera/schema": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsdown": "0.22.14",
    "typescript": "7.0.2"
  }
}
