{
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@open-generative/protocol": ["./packages/protocol/src/index.ts"],
      "@open-generative/catalog": ["./packages/catalog/src/index.ts"],
      "@open-generative/compiler": ["./packages/compiler/src/index.ts"],
      "@open-generative/runtime": ["./packages/runtime/src/index.ts"],
      "@open-generative/server": ["./packages/server/src/index.ts"],
      "@open-generative/client": ["./packages/client/src/index.ts"],
      "@open-generative/resources": ["./packages/resources/src/index.ts"],
      "@open-generative/capabilities": ["./packages/capabilities/src/index.ts"],
      "@open-generative/react": ["./packages/react/src/index.ts"],
      "@open-generative/components": ["./packages/components/src/index.ts"],
      "@open-generative/ui": ["./packages/ui/src/index.ts"],
      "@open-generative/ai-sdk": ["./packages/ai-sdk/src/index.ts"],
      "@open-generative/ai-sdk/*": ["./packages/ai-sdk/src/*.ts"],
      "@open-generative/mastra": ["./packages/mastra/src/index.ts"],
      "@open-generative/ag-ui": ["./packages/ag-ui/src/index.ts"],
      "@open-generative/ag-ui/*": ["./packages/ag-ui/src/*.ts"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "verbatimModuleSyntax": true,
    "ignoreDeprecations": "6.0"
  }
}
