{
  "name": "@open-tessera/studio",
  "version": "0.3.25",
  "license": "MIT",
  "homepage": "https://open-tessera.netlify.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErKeLost/Tessera.git",
    "directory": "apps/studio"
  },
  "description": "Local-first Nitro server for the Tessera database analysis workspace on Node.js and Bun.",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "studio": "./dist/cli.mjs"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./main": {
      "types": "./dist/main.d.mts",
      "import": "./dist/main.mjs",
      "default": "./dist/main.mjs"
    }
  },
  "scripts": {
    "build": "bun run generate:openui-prompt && bun run build:server && bun run build:client",
    "build:client": "vite build",
    "build:server": "tsdown",
    "dev": "bun scripts/dev.ts",
    "dev:vite": "vite --host 127.0.0.1 --port 4317",
    "generate:openui-prompt": "bun scripts/generate-openui-prompt.ts",
    "lint": "tsc --noEmit",
    "prepack": "bun run build",
    "test": "bun test src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.80",
    "@assistant-ui/react": "0.15.16",
    "@assistant-ui/react-ai-sdk": "1.4.7",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@iconify/react": "6.0.2",
    "@libsql/client": "0.17.4",
    "@lobehub/icons": "5",
    "@mastra/core": "1.66.0",
    "@mastra/libsql": "1.23.0",
    "@mastra/memory": "1.29.0",
    "@open-tessera/agent": "workspace:*",
    "@open-tessera/capabilities": "workspace:*",
    "@open-tessera/compiler": "workspace:*",
    "@open-tessera/data-agent": "workspace:*",
    "@open-tessera/database": "workspace:*",
    "@open-tessera/mongodb": "workspace:*",
    "@open-tessera/mysql": "workspace:*",
    "@open-tessera/postgres": "workspace:*",
    "@open-tessera/runtime": "workspace:*",
    "@open-tessera/schema": "workspace:*",
    "@open-tessera/sqlite": "workspace:*",
    "@open-tessera/turso": "workspace:*",
    "@openuidev/lang-core": "1.0.0",
    "@openuidev/react-lang": "1.0.0",
    "@pierre/diffs": "1.3.5",
    "@shadcn/react": "^0.3.1",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-query": "^5.101.4",
    "ai": "7.0.105",
    "border-beam": "1.3.0",
    "chalk": "5.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "goey-toast": "^0.5.0",
    "h3": "2.0.1-rc.22",
    "input-otp": "^1.5.0",
    "lucide-react": "1.31.0",
    "motion": "^13.1.0",
    "nanoid": "^6.0.1",
    "nitro": "3.0.260610-beta",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.12.3",
    "react-router": "^8.3.0",
    "recharts": "2.15.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "srvx": "^0.11.16",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "thinking-orbs": "0.3.1",
    "tw-shimmer": "^0.4.12",
    "use-stick-to-bottom": "1.1.6",
    "vaul": "^1.1.2",
    "zod": "4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "tsdown": "0.22.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
