{
  "name": "@open-tessera/studio",
  "version": "0.3.12",
  "license": "MIT",
  "homepage": "https://open-tessera.netlify.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErKeLost/Tessera.git",
    "directory": "apps/studio"
  },
  "description": "Local-first Nitro server for the Tessera database analysis workspace on Node.js and Bun.",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "studio": "./dist/main.mjs"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./main": {
      "types": "./dist/main.d.mts",
      "import": "./dist/main.mjs",
      "default": "./dist/main.mjs"
    }
  },
  "scripts": {
    "build": "bun run build:server && bun run build:client",
    "build:client": "vite build",
    "build:server": "tsdown",
    "dev": "vite --host 127.0.0.1 --port 4317",
    "lint": "tsc --noEmit",
    "prepack": "bun run build",
    "test": "bun test src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.79",
    "@assistant-ui/react": "0.15.16",
    "@assistant-ui/react-ai-sdk": "1.4.7",
    "@assistant-ui/react-markdown": "^0.14.10",
    "@open-tessera/capabilities": "workspace:*",
    "@open-tessera/compiler": "workspace:*",
    "@open-tessera/data-agent": "workspace:*",
    "@open-tessera/database": "workspace:*",
    "@open-tessera/mongodb": "workspace:*",
    "@open-tessera/mysql": "workspace:*",
    "@open-tessera/postgres": "workspace:*",
    "@open-tessera/runtime": "workspace:*",
    "@open-tessera/schema": "workspace:*",
    "@open-tessera/sqlite": "workspace:*",
    "@open-tessera/turso": "workspace:*",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@iconify/react": "6.0.2",
    "@libsql/client": "0.17.4",
    "@lobehub/fluent-emoji": "4",
    "@lobehub/icons": "5",
    "@lobehub/ui": "5.32.2",
    "@mastra/ai-sdk": "1.9.1",
    "@mastra/core": "1.61.0",
    "@mastra/libsql": "1.21.1",
    "@mastra/memory": "1.27.0",
