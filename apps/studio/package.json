{
  "name": "@data-elements/studio",
  "version": "0.1.6",
  "license": "MIT",
  "homepage": "https://data-elements.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/data-elements/data-elements.git",
    "directory": "apps/studio"
  },
  "description": "Local-first Hono server for the Tessera database analysis workspace on Node.js and Bun.",
  "type": "module",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "bun": ">=1.3",
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./main": {
      "types": "./dist/main.d.mts",
      "import": "./dist/main.mjs",
      "default": "./dist/main.mjs"
    }
  },
  "scripts": {
    "build": "bun run build:server && bun run build:client",
    "build:client": "vite build",
    "build:server": "tsdown",
    "dev": "bun run scripts/dev.ts",
    "lint": "tsc --noEmit",
    "prepack": "bun run build",
    "test": "bun test src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.69",
    "@assistant-ui/react": "0.15.14",
    "@assistant-ui/react-ai-sdk": "1.4.5",
