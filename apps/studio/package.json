    "@data-elements/capability-broker": "workspace:*",
    "@data-elements/compiler": "workspace:*",
    "@data-elements/data-agent": "workspace:*",
    "@data-elements/database": "workspace:*",
    "@data-elements/mongodb": "workspace:*",
    "@data-elements/mysql": "workspace:*",
    "@data-elements/postgres": "workspace:*",
    "@data-elements/sqlite": "workspace:*",
    "@data-elements/turso": "workspace:*",
    "@data-elements/runtime": "workspace:*",
    "@data-elements/schema": "workspace:*",
    "@iconify/react": "6.0.2",
    "@hono/node-server": "^1.19.9",
    "@libsql/client": "0.17.4",
    "@lobehub/fluent-emoji": "4",
    "@lobehub/icons": "5",
    "@lobehub/ui": "5.32.2",
    "@mastra/ai-sdk": "1.8.0",
    "@mastra/core": "1.59.0",
    "@mastra/libsql": "1.20.0",
    "@mastra/memory": "1.26.2",
    "@paper-design/shaders-react": "0.0.80",
