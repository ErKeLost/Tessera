    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
